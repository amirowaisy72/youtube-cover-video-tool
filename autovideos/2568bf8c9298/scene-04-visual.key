{"s": {"beats": [], "code": "title_box = thing(\"game_case\", x=-3.6, h=3.0, color=CREAM)\nenter(title_box, \"draw\")\ncamera(zoom=1.3, to=(-3.6, 0.2))\nsfx(\"whoosh\")\n\nwhen(\"whoever owns the asset\")\ncamera(zoom=1.0, to=(1.8, 0.2))\nowner_person = thing(\"person\", x=0.2, h=2.8, color=CREAM)\nbag = thing(\"money_bag\", x=3.6, h=3.0, color=CREAM)\nenter(owner_person, \"draw\")\nenter(bag, \"draw\")\nflow(title_box, bag, item=\"coin\", n=7)\n\nwhen(\"asset, not the person trading hours for a paycheck\")\ncamera(zoom=1.0, to=(0.0, 0.2))\n\nwhen(\"hours for a paycheck. Subscribe to PocketIQ for more smart money truths!\")\nclear()\ncamera(zoom=1.0, to=(0.0, 0.2))\nsfx(\"swoosh_down\")\n", "duration": 10.7, "narration": "A big title doesn't always mean big wealth\u2014the real money goes to whoever owns the asset, not the person trading hours for a paycheck. Subscribe to PocketIQ for more smart money truths!", "objects": [{"id": "n0", "obj": "game_case"}, {"id": "n1", "obj": "person"}, {"id": "n2", "obj": "money_bag"}, {"id": "n3", "obj": "coin"}], "theme": "visual", "words": [["A", 0.0], ["big", 0.22], ["title", 0.48], ["doesn't", 0.78], ["always", 1.16], ["mean", 1.38], ["big", 1.72], ["wealth\u2014the", 1.96], ["real", 2.76], ["money", 3.0], ["goes", 3.22], ["to", 3.48], ["whoever", 3.62], ["owns", 3.92], ["the", 4.3], ["asset,", 4.6], ["not", 5.34], ["the", 5.52], ["person", 5.68], ["trading", 5.96], ["hours", 6.4], ["for", 6.66], ["a", 6.92], ["paycheck.", 7.0], ["Subscribe", 8.14], ["to", 8.44], ["PocketIQ", 8.64], ["for", 9.24], ["more", 9.42], ["smart", 9.64], ["money", 9.9], ["truths!", 10.14]]}, "script": 1, "v": true}