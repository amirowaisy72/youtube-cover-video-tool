{"s": {"beats": [], "code": "game_star = thing(\"star\", x=-3.6, h=3.0, color=CREAM)\ngta_lbl = text(\"GTA 6\", x=-3.6, y=2.5, size=1.05, style=\"title\", color=CREAM)\nenter(game_star, \"draw\")\nplay(Create(gta_lbl), run_time=0.6, sound=\"pop\")\npulse(game_star)\ncamera(zoom=1.3, to=(-3.6, 0.3))\n\nwhen(\"over $1 billion in its first week\")\ncamera(zoom=1.0, to=(0.0, 0.2))\nvault = thing(\"bank\", x=3.6, h=3.2, color=CREAM)\nenter(vault, \"draw\")\namt = text(\"$0\", x=3.6, y=2.5, size=1.05, style=\"number\", color=CREAM)\nplay(Create(amt), run_time=0.5, sound=\"click\")\ncount(amt, to=1, frm=0, prefix=\"$\", suffix=\" billion\", dur=1.1)\npile(\"coin\", n=8, x=3.6, size=0.55)\n\nwhen(\"actress playing Lucia\")\ncamera(zoom=1.3, to=(-0.2, 0.1))\nactor = thing(\"microphone\", x=-0.2, h=2.6, color=CREAM)\nenter(actor, \"draw\")\nstar_lbl = text(\"STAR SHARE?\", x=-0.2, y=2.5, size=0.85, style=\"label\", color=CREAM)\nplay(Create(star_lbl), run_time=0.5, sound=\"ding\")\n\nwhen(\"flow down to its star\")\ncamera(zoom=1.0, to=(0.0, 0.0))\nmove(actor, to=(-1.4, -1.2), dur=0.7, arc=True)\nshake(actor)\n", "duration": 13.2, "narration": "GTA 6 is predicted to make over $1 billion in its first week, yet the actress playing Lucia almost certainly isn't a millionaire from it. Why doesn't a massive payday for a game company flow down to its star?", "objects": [{"id": "n0", "obj": "star"}, {"id": "n1", "obj": "bank"}, {"id": "n2", "obj": "coin"}, {"id": "n3", "obj": "microphone"}], "theme": "visual", "words": [["GTA", 0.0], ["6", 0.54], ["is", 0.96], ["predicted", 1.2], ["to", 1.56], ["make", 1.74], ["over", 1.96], ["$1", 2.22], ["billion", 2.48], ["in", 2.96], ["its", 3.32], ["first", 3.5], ["week,", 3.74], ["yet", 4.46], ["the", 4.62], ["actress", 5.1], ["playing", 5.1], ["Lucia", 5.44], ["almost", 5.94], ["certainly", 6.28], ["isn't", 6.68], ["a", 7.08], ["millionaire", 7.26], ["from", 7.48], ["it.", 7.8], ["Why", 8.6], ["doesn't", 8.74], ["a", 9.0], ["massive", 9.14], ["payday", 9.44], ["for", 9.9], ["a", 10.12], ["game", 10.2], ["company", 10.42], ["flow", 10.8], ["down", 11.12], ["to", 11.42], ["its", 11.5], ["star?", 11.72]]}, "script": 1, "v": true}