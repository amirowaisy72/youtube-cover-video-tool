{"s": {"beats": [], "code": "title_box = thing(\"game_case\", x=-3.6, h=3.0, color=PURPLE)\nenter(title_box, \"grow\")\ncamera(zoom=1.25, to=(-3.6, 0.2))\nsfx(\"whoosh\")\n\nwhen(\"whoever owns the asset\")\ncamera(zoom=1.0, to=(0.0, 0.2))\nowner_person = thing(\"person\", x=0.2, h=2.8, color=TEAL)\nbag = thing(\"money_bag\", x=3.6, h=3.0, color=GREEN)\nenter(owner_person, \"pop\")\nenter(bag, \"pop\")\nflow(title_box, bag, item=\"coin\", n=7)\n\nwhen(\"asset, not the person trading hours for a paycheck\")\nmove(title_box, to=(-8.5, 2.2), dur=0.45)\nmove(owner_person, to=(-2.0, 3.8), dur=0.45)\nmove(bag, to=(8.5, 2.2), dur=0.45)\ncamera(zoom=1.0, to=(0.0, 0.2))\n\nwhen(\"hours for a paycheck. Subscribe to PocketIQ for more smart money truths!\")\nclear()\ncamera(zoom=1.0, to=(0.0, 0.2))\nsfx(\"swoosh_down\")\n", "duration": 10.2, "narration": "A big title doesn't always mean big wealth\u2014the real money goes to whoever owns the asset, not the person trading hours for a paycheck. Subscribe to PocketIQ for more smart money truths!", "objects": [{"id": "n0", "obj": "game_case"}, {"id": "n1", "obj": "person"}, {"id": "n2", "obj": "money_bag"}, {"id": "n3", "obj": "coin"}], "theme": "visual", "words": [["A", 0.0], ["big", 0.26], ["title", 0.46], ["doesn't", 0.78], ["always", 1.08], ["mean", 1.32], ["big", 1.62], ["wealth\u2014the", 1.86], ["real", 2.62], ["money", 2.88], ["goes", 3.14], ["to", 3.4], ["whoever", 3.54], ["owns", 3.8], ["the", 4.18], ["asset,", 4.42], ["not", 4.98], ["the", 5.08], ["person", 5.24], ["trading", 5.5], ["hours", 5.96], ["for", 6.18], ["a", 6.42], ["paycheck.", 6.48], ["Subscribe", 7.5], ["to", 7.8], ["PocketIQ", 7.98], ["for", 8.6], ["more", 8.78], ["smart", 8.98], ["money", 9.3], ["truths!", 9.62]]}, "script": 1, "v": true}