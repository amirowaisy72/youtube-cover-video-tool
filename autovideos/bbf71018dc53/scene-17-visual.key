{"s": {"beats": [], "code": "waves18 = thing(\"waves\", x=-3.2, h=2.6, color=\"blue\")\nbag18 = thing(\"money_bag\", x=3.2, h=3.2, color=\"gold\")\nenter(waves18, \"left\", dur=0.7)\nenter(bag18, \"right\", dur=0.7)\nwhen(\"people who prepare early\")\nflow(waves18, bag18, item=\"coin\", n=8)\nwhen(\"Subscribe to PocketIQ\")\nclear()\nt18 = text(\"PocketIQ\", x=0, y=0.6, size=1.4, style=\"title\", color=\"gold\")\nenter(t18, \"pop\", dur=0.7)\npulse(t18)\n", "duration": 11.4, "narration": "Every major cultural launch creates a temporary river of money, and the people who prepare early are the ones who get paid. Subscribe to PocketIQ for more simple, bite-sized ways to build smarter money habits.", "objects": [{"id": "n0", "obj": "waves"}, {"id": "n1", "obj": "money_bag"}, {"id": "n2", "obj": "coin"}], "theme": "visual", "words": [["Every", 0.0], ["major", 0.36], ["cultural", 0.62], ["launch", 1.04], ["creates", 1.36], ["a", 1.7], ["temporary", 1.92], ["river", 2.28], ["of", 2.5], ["money,", 2.7], ["and", 3.26], ["the", 3.34], ["people", 3.42], ["who", 3.7], ["prepare", 3.94], ["early", 4.18], ["are", 4.58], ["the", 4.82], ["ones", 4.84], ["who", 5.1], ["get", 5.34], ["paid.", 5.5], ["Subscribe", 6.4], ["to", 6.8], ["PocketIQ", 7.04], ["for", 7.7], ["more", 7.92], ["simple,", 8.14], ["bite-sized", 8.6], ["ways", 9.26], ["to", 9.58], ["build", 9.74], ["smarter", 10.02], ["money", 10.44], ["habits.", 10.76]]}, "script": 1, "v": false}