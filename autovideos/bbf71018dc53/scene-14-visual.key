{"s": {"beats": [], "code": "tag15 = thing(\"price_tag\", x=-2.5, h=2.8, text=\"+40%\", color=\"green\")\nenter(tag15, \"pop\", dur=0.7)\nwhen(\"30% to 50% above\")\np15 = text(\"+30% - 50%\", x=2.5, y=2.2, size=1.05, style=\"number\", color=\"gold\")\nadd(p15)\ngrow(tag15, k=1.3, axis=\"y\")\nwhen(\"keeping boxes sealed\")\nclear()\nlock15 = thing(\"lock\", x=0, h=3.2, color=\"blue\")\nenter(lock15, \"pop\", dur=0.7)\npulse(lock15)\n", "duration": 12.9, "narration": "Buyers who miss the store shelves often pay 30% to 50% above retail price on resale marketplaces months later. The key is keeping boxes sealed and never spending rent money on risky inventory.", "objects": [{"id": "n0", "obj": "price_tag"}, {"id": "n1", "obj": "lock"}], "theme": "visual", "words": [["Buyers", 0.0], ["who", 0.4], ["miss", 0.62], ["the", 0.82], ["store", 1.06], ["shelves", 1.2], ["often", 1.5], ["pay", 1.84], ["30%", 2.14], ["to", 2.82], ["50%", 2.98], ["above", 3.66], ["retail", 3.92], ["price", 4.3], ["on", 4.66], ["resale", 4.94], ["marketplaces", 5.36], ["months", 6.08], ["later.", 6.4], ["The", 7.84], ["key", 7.88], ["is", 8.12], ["keeping", 8.32], ["boxes", 8.62], ["sealed", 9.0], ["and", 9.36], ["never", 9.58], ["spending", 9.78], ["rent", 10.12], ["money", 10.46], ["on", 10.7], ["risky", 10.96], ["inventory.", 11.22]]}, "script": 1, "v": false}