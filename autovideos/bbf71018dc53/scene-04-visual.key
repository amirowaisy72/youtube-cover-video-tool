{"s": {"beats": [], "code": "chart5 = thing(\"line_chart\", x=-3.2, h=3.2, points=[0.3, 0.5, 0.8, 1.3, 2.0], color=\"green\")\nenter(chart5, \"draw\", dur=0.8)\nwhen(\"profits flow back\")\ngrow(chart5, k=1.4, axis=\"y\")\nwhen(\"buying even one share\")\nperson5 = thing(\"person\", x=3.2, h=3.2, color=\"teal\")\nenter(person5, \"pop\", dur=0.6)\ngive(chart5, to=person5, label=\"1 share\")\nwhen(\"coins flow\")\nflow(chart5, person5, item=\"coin\", n=8)\n", "duration": 14.7, "narration": "When a game sells tens of millions of copies, profits flow back to the parent company and lift its long-term value. You do not need to buy a whole factory\u2014buying even one share or a gaming index fund lets coins flow toward you as sales grow.", "objects": [{"id": "n0", "obj": "line_chart"}, {"id": "n1", "obj": "person"}, {"id": "n2", "obj": "coin"}], "theme": "visual", "words": [["When", 0.0], ["a", 0.28], ["game", 0.58], ["sells", 0.64], ["tens", 0.94], ["of", 1.2], ["millions", 1.4], ["of", 1.68], ["copies,", 1.9], ["profits", 2.66], ["flow", 2.86], ["back", 3.26], ["to", 3.48], ["the", 3.58], ["parent", 3.7], ["company", 3.96], ["and", 4.38], ["lift", 4.64], ["its", 4.84], ["long-term", 5.1], ["value.", 5.56], ["You", 7.04], ["do", 7.08], ["not", 7.24], ["need", 7.4], ["to", 7.62], ["buy", 7.7], ["a", 7.86], ["whole", 8.06], ["factory\u2014buying", 8.28], ["even", 9.28], ["one", 9.62], ["share", 9.86], ["or", 10.08], ["a", 10.3], ["gaming", 10.36], ["index", 10.62], ["fund", 10.98], ["lets", 11.24], ["coins", 11.52], ["flow", 11.76], ["toward", 12.1], ["you", 12.5], ["as", 12.8], ["sales", 12.88], ["grow.", 13.12]]}, "script": 1, "v": false}