{"s": {"beats": [], "code": "tv8 = thing(\"tv\", x=-3.5, h=3.0, color=\"teal\")\nenter(tv8, \"pop\", dur=0.7)\nwhen(\"monthly ad payouts\")\nv8 = text(\"0 views\", x=1.5, y=2.5, size=0.95, style=\"number\", color=\"blue\")\nadd(v8)\ncount(v8, to=100000, frm=0, suffix=\" views\", dur=1.3)\nwhen(\"$500 from one\")\np8 = text(\"$0\", x=1.5, y=0.6, size=1.15, style=\"number\", color=\"gold\")\npile(\"coin\", n=8, x=1.5, size=0.6)\nadd(p8)\ncount(p8, to=500, frm=0, prefix=\"$\", dur=1.3)\n", "duration": 15.6, "narration": "Each view places small ads next to those guides, turning viewer attention into monthly ad payouts. For example, say a beginner guide channel gets 100,000 views in a month\u2014at a $5 ad rate, that equals $500 from one helpful video.", "objects": [{"id": "n0", "obj": "tv"}, {"id": "n1", "obj": "coin"}], "theme": "visual", "words": [["Each", 0.0], ["view", 0.32], ["places", 0.56], ["small", 0.86], ["ads", 1.26], ["next", 1.54], ["to", 1.82], ["those", 1.96], ["guides,", 2.2], ["turning", 2.94], ["viewer", 3.08], ["attention", 3.48], ["into", 3.88], ["monthly", 4.32], ["ad", 4.64], ["payouts.", 4.9], ["For", 5.96], ["example,", 6.14], ["say", 6.86], ["a", 6.98], ["beginner", 7.14], ["guide", 7.36], ["channel", 7.72], ["gets", 8.0], ["100,000", 8.24], ["views", 9.16], ["in", 9.52], ["a", 9.7], ["month\u2014at", 9.76], ["a", 10.44], ["$5", 10.58], ["ad", 10.96], ["rate,", 11.34], ["that", 11.86], ["equals", 11.98], ["$500", 12.28], ["from", 12.84], ["one", 13.5], ["helpful", 13.74], ["video.", 14.02]]}, "script": 1, "v": false}