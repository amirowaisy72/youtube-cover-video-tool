{"s": {"beats": [], "code": "crowd1 = thing(\"crowd\", x=-3.6, h=2.8, count=5, color=\"blue\")\nwallet1 = thing(\"wallet\", x=3.2, h=2.6, color=\"gold\")\nenter(crowd1, \"left\", dur=0.7)\nwhen(\"Most gamers\")\nenter(wallet1, \"right\", dur=0.7)\nflow(crowd1, wallet1, item=\"coin\", n=8)\nwhen(\"of dollars on GTA 6 this week, while a much smaller group will quietly use\")\nbadge(\"GAME LAUNCH\")\ng6_icon = VGroup(\n    RoundedRectangle(width=1.7, height=1.1, corner_radius=0.2, color=PINK, fill_color=PURPLE, fill_opacity=0.9),\n    Text(\"6\", font=FONT, color=GOLD).scale(0.85)\n).move_to((0.0, 2.5, 0))\nplay(GrowFromCenter(g6_icon), run_time=0.5, sound=\"pop\")\nclear()\nbank1 = thing(\"bank\", x=3.2, h=3.4, color=\"teal\")\nperson1 = thing(\"person\", x=-3.4, h=3.2, color=\"orange\")\nenter(person1, \"pop\", dur=0.6)\nenter(bank1, \"grow\", dur=0.8)\nflow(person1, bank1, item=\"coin\", n=8)\nwhen(\"Which side\")\npulse(person1)\npulse(bank1)\n", "duration": 11.4, "narration": "Most gamers will spend hundreds of dollars on GTA 6 this week, while a much smaller group will quietly use the same launch to fill their bank accounts. Which side of that trade do you want to be on?", "objects": [{"id": "n0", "obj": "crowd"}, {"id": "n1", "obj": "wallet"}, {"id": "n2", "obj": "coin"}, {"id": "n3", "obj": "bank"}, {"id": "n4", "obj": "person"}], "theme": "visual", "words": [["Most", 0.0], ["gamers", 0.38], ["will", 0.68], ["spend", 0.92], ["hundreds", 1.12], ["of", 1.44], ["dollars", 1.66], ["on", 1.9], ["GTA", 2.2], ["6", 2.56], ["this", 2.96], ["week,", 3.16], ["while", 3.74], ["a", 3.82], ["much", 4.02], ["smaller", 4.22], ["group", 4.52], ["will", 4.84], ["quietly", 5.1], ["use", 5.38], ["the", 5.7], ["same", 5.84], ["launch", 6.1], ["to", 6.36], ["fill", 6.54], ["their", 6.74], ["bank", 7.0], ["accounts.", 7.16], ["Which", 8.22], ["side", 8.36], ["of", 8.64], ["that", 8.74], ["trade", 8.98], ["do", 9.24], ["you", 9.48], ["want", 9.48], ["to", 9.62], ["be", 9.72], ["on?", 9.84]]}, "script": 1, "v": false}