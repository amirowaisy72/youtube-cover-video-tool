{"s": {"beats": [], "code": "chart6 = thing(\"line_chart\", x=0, h=3.4, points=[0.8, 1.6, 0.7, 1.8, 1.1, 1.5], color=\"gold\")\nenter(chart6, \"draw\", dur=0.8)\nwhen(\"swing wildly\")\nshake(chart6)\nwhen(\"buy steadily\")\nclear()\ncoin6 = thing(\"coin\", x=-2.2, h=1.2, color=\"gold\")\ncalendar6 = thing(\"calendar\", x=2.8, h=2.8, color=\"blue\")\nenter(calendar6, \"pop\", dur=0.6)\nenter(coin6, \"pop\", dur=0.5)\nflow(coin6, calendar6, item=\"coin\", n=8)\n", "duration": 11.3, "narration": "Keep in mind that stock prices often jump before release day and swing wildly right after launch. Smart investors buy steadily over time instead of chasing hype on a single morning.", "objects": [{"id": "n0", "obj": "line_chart"}, {"id": "n1", "obj": "coin"}, {"id": "n2", "obj": "calendar"}], "theme": "visual", "words": [["Keep", 0.0], ["in", 0.28], ["mind", 0.46], ["that", 0.68], ["stock", 0.92], ["prices", 1.1], ["often", 1.44], ["jump", 1.8], ["before", 2.1], ["release", 2.38], ["day", 2.7], ["and", 3.06], ["swing", 3.3], ["wildly", 3.52], ["right", 3.92], ["after", 4.32], ["launch.", 4.6], ["Smart", 6.14], ["investors", 6.32], ["buy", 6.72], ["steadily", 7.12], ["over", 7.42], ["time", 7.72], ["instead", 7.98], ["of", 8.26], ["chasing", 8.46], ["hype", 8.8], ["on", 9.14], ["a", 9.38], ["single", 9.46], ["morning.", 9.72]]}, "script": 1, "v": false}