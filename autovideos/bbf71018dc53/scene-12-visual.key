{"s": {"beats": [], "code": "link13 = thing(\"link\", x=-3.0, h=2.6, color=\"teal\")\nenter(link13, \"pop\", dur=0.7)\nwhen(\"Through affiliate links on review pages or social posts, stores pay you a 3% to\")\nshop13 = thing(\"shop\", x=0.3, h=2.6, color=\"blue\")\nenter(shop13, \"right\", dur=0.6)\nrate13 = text(\"3% - 8%\", x=3.2, y=2.2, size=1.1, style=\"number\", color=\"gold\")\nadd(rate13)\npulse(rate13)\nwhen(\"every time someone buys\")\npile(\"coin\", n=8, x=3.2, size=0.65)\n", "duration": 13.3, "narration": "You do not need to manufacture electronics in a warehouse to profit from that shopping spree. Through affiliate links on review pages or social posts, stores pay you a 3% to 8% commission every time someone buys through your link.", "objects": [{"id": "n0", "obj": "link"}, {"id": "n1", "obj": "shop"}, {"id": "n2", "obj": "coin"}], "theme": "visual", "words": [["You", 0.0], ["do", 0.2], ["not", 0.38], ["need", 0.54], ["to", 0.76], ["manufacture", 0.88], ["electronics", 1.34], ["in", 1.9], ["a", 2.28], ["warehouse", 2.42], ["to", 2.68], ["profit", 2.88], ["from", 3.14], ["that", 3.44], ["shopping", 3.62], ["spree.", 3.88], ["Through", 4.78], ["affiliate", 4.96], ["links", 5.32], ["on", 5.64], ["review", 5.88], ["pages", 6.14], ["or", 6.48], ["social", 6.76], ["posts,", 7.06], ["stores", 7.88], ["pay", 8.02], ["you", 8.3], ["a", 8.48], ["3%", 8.58], ["to", 9.08], ["8%", 9.2], ["commission", 9.74], ["every", 10.08], ["time", 10.4], ["someone", 10.72], ["buys", 11.02], ["through", 11.36], ["your", 11.6], ["link.", 11.82]]}, "script": 1, "v": false}