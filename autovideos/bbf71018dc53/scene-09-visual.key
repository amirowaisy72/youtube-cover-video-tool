{"s": {"beats": [], "code": "person10 = thing(\"person\", x=-3.4, h=3.2, color=\"orange\")\nenter(person10, \"pop\", dur=0.7)\nwhen(\"roleplay servers\")\ngear10 = thing(\"gear\", x=2.8, h=3.0, color=\"purple\")\nenter(gear10, \"grow\", dur=0.7)\nplay(Rotate(gear10, angle=3.14), run_time=1.0, sound=\"whoosh\")\nwhen(\"full-time incomes\")\nbag10 = thing(\"money_bag\", x=3.2, h=2.8, color=\"gold\")\nswap(gear10, name=\"money_bag\")\npulse(bag10)\nwhen(\"custom roleplay servers, car designs, and scripts for online worlds.\")\ncar10 = thing(\"car\", x=0.0, h=2.0, color=\"red\")\ndoc10 = thing(\"document\", x=3.4, h=2.5, color=\"teal\")\nenter(car10, \"right\", dur=0.5)\nenter(doc10, \"pop\", dur=0.5)\npulse(car10)\n", "duration": 14.7, "narration": "The third way is selling digital tools, servers, and custom mods to the player community. In GTA 5, thousands of creators earned full-time incomes building custom roleplay servers, car designs, and scripts for online worlds.", "objects": [{"id": "n0", "obj": "person"}, {"id": "n1", "obj": "gear"}, {"id": "n2", "obj": "money_bag"}, {"id": "n3", "obj": "car"}, {"id": "n4", "obj": "document"}], "theme": "visual", "words": [["The", 0.0], ["third", 0.22], ["way", 0.44], ["is", 0.74], ["selling", 0.96], ["digital", 1.22], ["tools,", 1.62], ["servers,", 2.38], ["and", 3.1], ["custom", 3.2], ["mods", 3.52], ["to", 3.84], ["the", 4.0], ["player", 4.12], ["community.", 4.32], ["In", 5.52], ["GTA", 5.54], ["5,", 5.94], ["thousands", 6.74], ["of", 7.06], ["creators", 7.18], ["earned", 7.5], ["full-time", 7.92], ["incomes", 8.4], ["building", 8.76], ["custom", 9.18], ["roleplay", 9.62], ["servers,", 10.14], ["car", 10.92], ["designs,", 11.1], ["and", 11.94], ["scripts", 12.08], ["for", 12.34], ["online", 12.62], ["worlds.", 12.92]]}, "script": 1, "v": false}