{"s": {"beats": [], "code": "console12 = thing(\"console\", x=-3.5, h=3.0, color=\"blue\")\nenter(console12, \"grow\", dur=0.7)\nwhen(\"PlayStation 5 and Xbox\")\nbadge(\"PS5\")\npulse(console12)\nwhen(\"controllers, headsets\")\nctrl12 = thing(\"controller\", x=-0.2, h=2.2, color=\"teal\")\nheadset12 = thing(\"headset\", x=2.6, h=2.6, color=\"orange\")\nenter(ctrl12, \"pop\", dur=0.5)\nenter(headset12, \"right\", dur=0.6)\nwhen(\"and desks right now\")\nclear()\ncrowd12 = thing(\"crowd\", x=-3.5, h=2.6, count=5, color=\"purple\")\nshop12 = thing(\"shop\", x=2.8, h=3.2, color=\"gold\")\nenter(crowd12, \"left\", dur=0.6)\nenter(shop12, \"grow\", dur=0.7)\nflow(crowd12, shop12, item=\"coin\", n=8)\n", "duration": 16.4, "narration": "The fourth way is selling physical gear and setup upgrades that gamers buy during a major console cycle. Because GTA 6 launched on PlayStation 5 and Xbox Series consoles before PC, millions of players are upgrading controllers, headsets, and desks right now.", "objects": [{"id": "n0", "obj": "console"}, {"id": "n1", "obj": "controller"}, {"id": "n2", "obj": "headset"}, {"id": "n3", "obj": "crowd"}, {"id": "n4", "obj": "shop"}, {"id": "n5", "obj": "coin"}], "theme": "visual", "words": [["The", 0.0], ["fourth", 0.22], ["way", 0.46], ["is", 0.76], ["selling", 1.02], ["physical", 1.24], ["gear", 1.62], ["and", 1.98], ["setup", 2.24], ["upgrades", 2.52], ["that", 3.0], ["gamers", 3.36], ["buy", 3.66], ["during", 3.96], ["a", 4.2], ["major", 4.46], ["console", 4.64], ["cycle.", 5.04], ["Because", 6.02], ["GTA", 6.24], ["6", 6.62], ["launched", 7.06], ["on", 7.32], ["PlayStation", 7.56], ["5", 7.92], ["and", 8.4], ["Xbox", 8.66], ["Series", 9.0], ["consoles", 9.42], ["before", 9.86], ["PC,", 10.24], ["millions", 11.14], ["of", 11.36], ["players", 11.6], ["are", 11.82], ["upgrading", 12.12], ["controllers,", 12.5], ["headsets,", 13.48], ["and", 14.2], ["desks", 14.32], ["right", 14.58], ["now.", 14.9]]}, "script": 1, "v": false}