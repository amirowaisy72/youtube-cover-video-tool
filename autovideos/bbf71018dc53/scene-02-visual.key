{"s": {"beats": [], "code": "crowd3 = thing(\"crowd\", x=-4.2, h=2.6, count=5, color=\"teal\")\nenter(crowd3, \"left\", dur=0.7)\nwhen(\"cash flows into five distinct buckets. If you position yourself early,\")\nb1 = thing(\"box\", x=-1.4, y=2.2, h=1.6, color=\"orange\")\nb2 = thing(\"box\", x=0.2, y=2.2, h=1.6, color=\"gold\")\nb3 = thing(\"box\", x=1.8, y=2.2, h=1.6, color=\"blue\")\nb4 = thing(\"box\", x=3.4, y=2.2, h=1.6, color=\"purple\")\nb5 = thing(\"box\", x=5.0, y=2.2, h=1.6, color=\"green\")\nenter(b1, \"top\", dur=0.4)\nenter(b2, \"top\", dur=0.4)\nenter(b3, \"top\", dur=0.4)\nenter(b4, \"top\", dur=0.4)\nenter(b5, \"top\", dur=0.4)\nwhen(\"capture a slice\")\nexit(b2)\npie3 = thing(\"pie\", x=4.6, h=2.4, share=0.25, color=\"gold\")\nenter(pie3, \"pop\", dur=0.5)\npulse(pie3)\n", "duration": 11.8, "narration": "When millions of players rush toward one massive entertainment launch, cash flows into five distinct buckets. If you position yourself early, you can capture a slice of that flow instead of just paying for it.", "objects": [{"id": "n0", "obj": "crowd"}, {"id": "n1", "obj": "box"}, {"id": "n2", "obj": "pie"}], "theme": "visual", "words": [["When", 0.0], ["millions", 0.34], ["of", 0.56], ["players", 0.8], ["rush", 1.0], ["toward", 1.44], ["one", 1.76], ["massive", 2.0], ["entertainment", 2.28], ["launch,", 2.72], ["cash", 3.64], ["flows", 3.74], ["into", 4.08], ["five", 4.42], ["distinct", 4.74], ["buckets.", 5.12], ["If", 6.12], ["you", 6.24], ["position", 6.4], ["yourself", 6.64], ["early,", 7.08], ["you", 7.74], ["can", 7.8], ["capture", 8.02], ["a", 8.3], ["slice", 8.54], ["of", 8.74], ["that", 8.92], ["flow", 9.08], ["instead", 9.32], ["of", 9.58], ["just", 9.8], ["paying", 10.02], ["for", 10.28], ["it.", 10.46]]}, "script": 1, "v": false}