{"s": {"beats": [], "code": "crowd7 = thing(\"crowd\", x=-3.8, h=2.8, count=5, color=\"blue\")\nenter(crowd7, \"left\", dur=0.7)\nwhen(\"hidden cars\")\ncar7 = thing(\"car\", x=0.8, h=2.2, color=\"red\")\nmagnifier7 = thing(\"magnifier\", x=4.0, h=2.4, color=\"gold\")\nenter(car7, \"pop\", dur=0.5)\nenter(magnifier7, \"pop\", dur=0.5)\nwhen(\"YouTube, TikTok\")\nclear()\ntv7 = thing(\"tv\", x=-3.2, h=3.0, color=\"red\")\nphone7 = thing(\"phone\", x=0.2, h=2.8, color=\"pink\")\nmag7 = thing(\"magnifier\", x=3.4, h=2.8, color=\"teal\")\nenter(tv7, \"grow\", dur=0.5)\nenter(phone7, \"grow\", dur=0.5)\nenter(mag7, \"grow\", dur=0.5)\n", "duration": 13.4, "narration": "The second way is building content around the massive wave of search traffic. Every time players get stuck on a mission, look for hidden cars, or compare console settings, they open YouTube, TikTok, or search engines.", "objects": [{"id": "n0", "obj": "crowd"}, {"id": "n1", "obj": "car"}, {"id": "n2", "obj": "magnifier"}, {"id": "n3", "obj": "tv"}, {"id": "n4", "obj": "phone"}], "theme": "visual", "words": [["The", 0.0], ["second", 0.2], ["way", 0.48], ["is", 0.74], ["building", 0.94], ["content", 1.24], ["around", 1.6], ["the", 1.96], ["massive", 2.12], ["wave", 2.4], ["of", 2.68], ["search", 2.9], ["traffic.", 3.14], ["Every", 4.06], ["time", 4.28], ["players", 4.54], ["get", 4.8], ["stuck", 5.12], ["on", 5.38], ["a", 5.58], ["mission,", 5.64], ["look", 6.12], ["for", 6.28], ["hidden", 6.46], ["cars,", 6.72], ["or", 7.44], ["compare", 7.64], ["console", 7.96], ["settings,", 8.34], ["they", 9.24], ["open", 9.44], ["YouTube,", 9.64], ["TikTok,", 10.36], ["or", 11.14], ["search", 11.38], ["engines.", 11.62]]}, "script": 1, "v": false}