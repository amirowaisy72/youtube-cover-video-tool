{"s": {"beats": [], "code": "game_box = thing(\"game_case\", x=-3.5, h=3.2, color=\"purple\")\nenter(game_box, \"grow\", dur=0.7)\nwhen(\"235 million\")\nn2 = text(\"0 million\", x=-3.5, y=2.6, size=0.95, style=\"number\", color=\"gold\")\nadd(n2)\ncount(n2, to=235, frm=0, suffix=\" million\", dur=1.3)\nwhen(\"$10 billion\")\nrev2 = text(\"$0 billion\", x=2.6, y=2.6, size=0.95, style=\"number\", color=\"green\")\npile(\"gold_bar\", n=8, x=2.6, size=0.7)\nadd(rev2)\ncount(rev2, to=10, frm=0, prefix=\"$\", suffix=\" billion\", dur=1.3)\nwhen(\"November 19, 2026\")\nclear()\nglobe2 = thing(\"globe\", x=0, h=3.5, color=\"blue\")\nenter(globe2, \"pop\", dur=0.7)\nbadge(\"NOV 19, 2026\")\nclone(globe2, n=4)\n", "duration": 18.1, "narration": "Since GTA 5 launched in 2013, it has sold 235 million copies and brought in over $10 billion in revenue. Now that GTA 6 has finally arrived on November 19, 2026, an even bigger wave of attention and money is moving across the globe.", "objects": [{"id": "n0", "obj": "game_case"}, {"id": "n1", "obj": "gold_bar"}, {"id": "n2", "obj": "globe"}], "theme": "visual", "words": [["Since", 0.0], ["GTA", 0.34], ["5", 0.78], ["launched", 1.22], ["in", 1.48], ["2013,", 1.7], ["it", 2.72], ["has", 2.8], ["sold", 3.0], ["235", 3.24], ["million", 4.56], ["copies", 4.88], ["and", 5.3], ["brought", 5.6], ["in", 5.82], ["over", 6.06], ["$10", 6.26], ["billion", 6.54], ["in", 7.08], ["revenue.", 7.48], ["Now", 8.86], ["that", 9.0], ["GTA", 9.26], ["6", 9.66], ["has", 10.04], ["finally", 10.26], ["arrived", 10.6], ["on", 10.98], ["November", 11.24], ["19,", 11.64], ["2026,", 12.5], ["an", 13.62], ["even", 13.82], ["bigger", 14.02], ["wave", 14.32], ["of", 14.54], ["attention", 14.7], ["and", 15.02], ["money", 15.3], ["is", 15.52], ["moving", 15.72], ["across", 16.0], ["the", 16.36], ["globe.", 16.54]]}, "script": 1, "v": false}