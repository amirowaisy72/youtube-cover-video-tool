{"s": {"beats": [], "code": "laptop9 = thing(\"laptop\", x=0, h=3.2, color=\"slate\")\nenter(laptop9, \"grow\", dur=0.7)\nwhen(\"Vice City locations\")\nmap9 = thing(\"map\", x=-3.5, h=2.8, color=\"green\")\nenter(map9, \"left\", dur=0.6)\nbadge(\"VICE CITY\")\nwhen(\"simple laptop\")\npulse(laptop9)\n", "duration": 12.1, "narration": "You do not even need to show your face or own the newest console to start. Clipping news updates, mapping out Vice City locations, or breaking down game mechanics works from a simple laptop.", "objects": [{"id": "n0", "obj": "laptop"}, {"id": "n1", "obj": "map"}], "theme": "visual", "words": [["You", 0.0], ["do", 0.2], ["not", 0.36], ["even", 0.6], ["need", 0.78], ["to", 1.02], ["show", 1.12], ["your", 1.3], ["face", 1.56], ["or", 1.82], ["own", 2.02], ["the", 2.2], ["newest", 2.34], ["console", 2.56], ["to", 3.0], ["start.", 3.26], ["Clipping", 4.66], ["news", 4.86], ["updates,", 5.2], ["mapping", 5.96], ["out", 6.2], ["Vice", 6.5], ["City", 6.78], ["locations,", 7.06], ["or", 8.04], ["breaking", 8.18], ["down", 8.46], ["game", 8.78], ["mechanics", 9.02], ["works", 9.4], ["from", 9.8], ["a", 10.02], ["simple", 10.14], ["laptop.", 10.42]]}, "script": 1, "v": false}