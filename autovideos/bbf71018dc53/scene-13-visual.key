{"s": {"beats": [], "code": "box14 = thing(\"box\", x=-3.0, h=3.0, color=\"gold\")\nenter(box14, \"grow\", dur=0.7)\nwhen(\"steelbooks, controller bundles\")\nbadge(\"COLLECTOR EDITION\")\npulse(box14)\nwhen(\"sell out fast\")\nshop14 = thing(\"shop\", x=3.2, h=3.2, color=\"red\")\nenter(shop14, \"right\", dur=0.7)\nmove(box14, to=shop14, side=\"left\", dur=0.9)\n", "duration": 14.4, "narration": "The fifth way is flipping limited collector items and rare physical editions. Whenever a historic franchise drops after a 13-year wait, special steelbooks, controller bundles, and launch-week merchandise sell out fast in local stores.", "objects": [{"id": "n0", "obj": "box"}, {"id": "n1", "obj": "shop"}], "theme": "visual", "words": [["The", 0.0], ["fifth", 0.22], ["way", 0.42], ["is", 0.7], ["flipping", 0.98], ["limited", 1.24], ["collector", 1.64], ["items", 2.08], ["and", 2.44], ["rare", 2.78], ["physical", 3.02], ["editions.", 3.34], ["Whenever", 4.42], ["a", 4.64], ["historic", 4.96], ["franchise", 5.28], ["drops", 5.7], ["after", 6.08], ["a", 6.46], ["13-year", 6.64], ["wait,", 7.24], ["special", 7.8], ["steelbooks,", 8.02], ["controller", 9.16], ["bundles,", 9.34], ["and", 10.26], ["launch-week", 10.32], ["merchandise", 10.78], ["sell", 11.24], ["out", 11.66], ["fast", 11.88], ["in", 12.2], ["local", 12.38], ["stores.", 12.7]]}, "script": 1, "v": false}