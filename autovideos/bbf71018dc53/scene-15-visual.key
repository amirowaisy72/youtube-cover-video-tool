{"s": {"beats": [], "code": "person16a = thing(\"person\", x=-3.5, h=3.2, color=\"red\")\nperson16b = thing(\"person\", x=3.5, h=3.2, color=\"green\")\nenter(person16a, \"left\", dur=0.6)\nenter(person16b, \"right\", dur=0.6)\nwhen(\"Consumers spend cash\")\ncash16 = thing(\"cash\", x=-1.2, h=2.2, color=\"gold\")\nenter(cash16, \"pop\", dur=0.5)\nmove(cash16, to=person16a, side=\"right\", dur=0.8)\nwhen(\"builders and investors\")\nbag16 = thing(\"money_bag\", x=1.2, h=2.8, color=\"gold\")\nenter(bag16, \"grow\", dur=0.6)\nmove(bag16, to=person16b, side=\"left\", dur=0.8)\n", "duration": 10.9, "narration": "Notice how all five paths share one simple money rule. Consumers spend cash for instant fun, while builders and investors set up assets before the crowd arrives.", "objects": [{"id": "n0", "obj": "person"}, {"id": "n1", "obj": "cash"}, {"id": "n2", "obj": "money_bag"}], "theme": "visual", "words": [["Notice", 0.0], ["how", 0.4], ["all", 0.7], ["five", 1.0], ["paths", 1.3], ["share", 1.66], ["one", 1.98], ["simple", 2.28], ["money", 2.6], ["rule.", 2.86], ["Consumers", 4.32], ["spend", 4.7], ["cash", 4.92], ["for", 5.26], ["instant", 5.46], ["fun,", 5.72], ["while", 6.42], ["builders", 6.54], ["and", 6.86], ["investors", 7.24], ["set", 7.54], ["up", 7.88], ["assets", 8.06], ["before", 8.34], ["the", 8.66], ["crowd", 8.9], ["arrives.", 9.1]]}, "script": 1, "v": false}