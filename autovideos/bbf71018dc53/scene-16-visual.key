{"s": {"beats": [], "code": "b17a = thing(\"box\", x=-4.4, h=2.5, color=\"blue\")\nb17b = thing(\"box\", x=-2.2, h=2.5, color=\"teal\")\nb17c = thing(\"box\", x=0.0, h=2.5, color=\"gold\")\nb17d = thing(\"box\", x=2.2, h=2.5, color=\"purple\")\nb17e = thing(\"box\", x=4.4, h=2.5, color=\"orange\")\nenter(b17a, \"pop\", dur=0.4)\nenter(b17b, \"pop\", dur=0.4)\nenter(b17c, \"pop\", dur=0.4)\nenter(b17d, \"pop\", dur=0.4)\nenter(b17e, \"pop\", dur=0.4)\nwhen(\"pick one lane\")\npulse(b17c)\nwhen(\"gaming stocks or broad funds\")\nmove(b17a, to=(-5.2, 1.8), dur=0.35, arc=True)\nmove(b17b, to=(-2.6, -0.4), dur=0.35, arc=True)\nmove(b17c, to=(0.2, 2.0), dur=0.35, arc=True)\nmove(b17d, to=(2.8, -0.6), dur=0.35, arc=True)\nmove(b17e, to=(5.3, 1.7), dur=0.35, arc=True)\nbank17 = thing(\"bank\", x=-3.0, h=3.2, color=\"green\")\nswap(b17a, name=\"bank\")\nwhen(\"start creating helpful guides\")\nlaptop17 = thing(\"laptop\", x=3.0, h=3.0, color=\"purple\")\nswap(b17c, name=\"laptop\")\n", "duration": 15.1, "narration": "You do not have to chase all five at once\u2014pick one lane that matches your budget and skills today. If you have spare savings, research gaming stocks or broad funds; if you have zero cash, start creating helpful guides or digital assets.", "objects": [{"id": "n0", "obj": "box"}, {"id": "n1", "obj": "bank"}, {"id": "n2", "obj": "laptop"}], "theme": "visual", "words": [["You", 0.0], ["do", 0.2], ["not", 0.38], ["have", 0.56], ["to", 0.82], ["chase", 0.88], ["all", 1.12], ["five", 1.42], ["at", 1.68], ["once\u2014pick", 1.98], ["one", 2.58], ["lane", 2.88], ["that", 3.06], ["matches", 3.26], ["your", 3.5], ["budget", 3.84], ["and", 4.1], ["skills", 4.4], ["today.", 4.66], ["If", 5.98], ["you", 6.24], ["have", 6.36], ["spare", 6.6], ["savings,", 6.84], ["research", 7.84], ["gaming", 8.04], ["stocks", 8.4], ["or", 8.74], ["broad", 8.98], ["funds;", 9.26], ["if", 9.9], ["you", 10.0], ["have", 10.08], ["zero", 10.28], ["cash,", 10.66], ["start", 11.4], ["creating", 11.62], ["helpful", 12.02], ["guides", 12.42], ["or", 12.78], ["digital", 13.1], ["assets.", 13.42]]}, "script": 1, "v": false}