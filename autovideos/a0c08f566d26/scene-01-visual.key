{"s": {"beats": [], "code": "doc = thing(\"document\", x=-3.2, h=3.2, color=CREAM)\nenter(doc, \"left\")\nsfx(\"pop\")\n\nwhen(\"buyout contracts\")\nstamp = thing(\"lock\", x=-3.2, h=1.8, color=RED)\nenter(stamp, \"top\")\nlabel(stamp, \"BUYOUT\")\n\nwhen(\"slice of the game's profits\")\nclear()\npie_slice = thing(\"pie\", x=-2.5, h=3.2, share=0.25, color=PURPLE)\nenter(pie_slice, \"grow\")\n\nwhen(\"around $1,000 per 4-hour session\")\nclock_obj = thing(\"clock\", x=2.8, h=2.8, color=BLUE)\nenter(clock_obj, \"pop\")\nrate = text(\"$0\", x=2.8, y=2.3, style=\"number\", color=GOLD)\nadd(rate)\ncount(rate, to=1000, frm=0, prefix=\"$\", dur=1.1)\n", "duration": 13.1, "narration": "In video games, voice and motion-capture actors usually sign buyout contracts. Instead of taking a slice of the game's profits, they get paid a flat union day rate\u2014often around $1,000 per 4-hour session.", "objects": [{"id": "n0", "obj": "document"}, {"id": "n1", "obj": "lock"}, {"id": "n2", "obj": "pie"}, {"id": "n3", "obj": "clock"}], "theme": "visual", "words": [["In", 0.0], ["video", 0.26], ["games,", 0.52], ["voice", 1.22], ["and", 1.42], ["motion-capture", 1.7], ["actors", 2.36], ["usually", 2.7], ["sign", 3.12], ["buyout", 3.42], ["contracts.", 3.9], ["Instead", 5.06], ["of", 5.22], ["taking", 5.4], ["a", 5.66], ["slice", 5.88], ["of", 6.04], ["the", 6.28], ["game's", 6.32], ["profits,", 6.68], ["they", 7.36], ["get", 7.42], ["paid", 7.6], ["a", 7.84], ["flat", 7.98], ["union", 8.22], ["day", 8.52], ["rate\u2014often", 8.82], ["around", 9.62], ["$1,000", 9.92], ["per", 10.88], ["4-hour", 11.18], ["session.", 11.5]]}, "script": 1, "v": true}