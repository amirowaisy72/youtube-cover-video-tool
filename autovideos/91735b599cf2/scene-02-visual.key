{"s": {"beats": [], "code": "cal = thing(\"calendar\", x=-3.4, h=3.0, color=ORANGE)\nenter(cal, \"top\")\nsfx(\"whoosh\")\n\nwhen(\"100 sessions over 3 years\")\nstack = thing(\"cash\", x=-0.2, h=2.6, color=GREEN)\nenter(stack, \"bottom\")\ntotal = text(\"$0\", x=-0.2, y=2.1, style=\"number\", color=GOLD)\nadd(total)\ncount(total, to=100000, frm=0, prefix=\"$\", dur=1.2)\n\nwhen(\"publisher keeps 100%\")\npub = thing(\"factory\", x=3.5, h=3.6, color=SLATE)\nenter(pub, \"right\")\nchart = thing(\"bar_chart\", x=3.5, h=2.2, values=[0.3, 0.6, 1.0], color=GOLD)\nmove(chart, to=(3.5, 2.2), dur=0.7)\npulse(pub)\n", "duration": 14.8, "narration": "Even if an actor works 100 sessions over 3 years of production, that stack of checks adds up to roughly $100,000 before taxes and agent fees. Meanwhile, the publisher keeps 100% of the billion-dollar sales chart.", "objects": [{"id": "n0", "obj": "calendar"}, {"id": "n1", "obj": "cash"}, {"id": "n2", "obj": "factory"}, {"id": "n3", "obj": "bar_chart"}], "theme": "visual", "words": [["Even", 0.0], ["if", 0.32], ["an", 0.5], ["actor", 0.66], ["works", 0.88], ["100", 1.18], ["sessions", 1.66], ["over", 2.14], ["3", 2.44], ["years", 2.68], ["of", 3.0], ["production,", 3.18], ["that", 3.92], ["stack", 4.08], ["of", 4.26], ["checks", 4.46], ["adds", 4.7], ["up", 4.92], ["to", 5.12], ["roughly", 5.24], ["$100,000", 5.5], ["before", 6.72], ["taxes", 7.1], ["and", 7.54], ["agent", 7.9], ["fees.", 8.04], ["Meanwhile,", 9.54], ["the", 10.3], ["publisher", 10.46], ["keeps", 10.76], ["100%", 11.08], ["of", 12.0], ["the", 12.22], ["billion-dollar", 12.32], ["sales", 12.88], ["chart.", 13.16]]}, "script": 1, "v": true}