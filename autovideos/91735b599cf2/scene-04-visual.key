{"s": {"beats": [], "code": "title_box = thing(\"game_case\", x=-3.6, h=3.0, color=PURPLE)\nenter(title_box, \"grow\")\nsfx(\"whoosh\")\n\nwhen(\"whoever owns the asset\")\nowner_person = thing(\"person\", x=0.2, h=2.8, color=TEAL)\nbag = thing(\"money_bag\", x=3.6, h=3.0, color=GREEN)\nenter(owner_person, \"pop\")\nenter(bag, \"pop\")\nflow(title_box, bag, item=\"coin\", n=7)\n\nwhen(\"asset, not the person trading hours for a paycheck. Subscribe to PocketIQ for more\")\nclear()\nworker_person = thing(\"person\", x=-3.6, h=2.8, color=ORANGE)\nclk = thing(\"clock\", x=-0.4, h=2.7, color=BLUE)\npay = thing(\"cash\", x=3.6, h=2.7, color=GOLD)\nenter(worker_person, \"left\")\nenter(clk, \"pop\")\nenter(pay, \"right\")\nflow(clk, pay, item=\"coin\", n=5)\nsub_lbl = text(\"PocketIQ\", x=3.6, y=2.5, size=1.0, style=\"title\", color=GOLD)\nadd(sub_lbl)\npulse(sub_lbl)\n", "duration": 10.2, "narration": "A big title doesn't always mean big wealth\u2014the real money goes to whoever owns the asset, not the person trading hours for a paycheck. Subscribe to PocketIQ for more smart money truths!", "objects": [{"id": "n0", "obj": "game_case"}, {"id": "n1", "obj": "person"}, {"id": "n2", "obj": "money_bag"}, {"id": "n3", "obj": "coin"}, {"id": "n4", "obj": "clock"}, {"id": "n5", "obj": "cash"}], "theme": "visual", "words": [["A", 0.0], ["big", 0.26], ["title", 0.46], ["doesn't", 0.78], ["always", 1.08], ["mean", 1.32], ["big", 1.62], ["wealth\u2014the", 1.86], ["real", 2.62], ["money", 2.9], ["goes", 3.14], ["to", 3.4], ["whoever", 3.54], ["owns", 3.8], ["the", 4.18], ["asset,", 4.42], ["not", 5.0], ["the", 5.08], ["person", 5.22], ["trading", 5.5], ["hours", 5.96], ["for", 6.18], ["a", 6.42], ["paycheck.", 6.48], ["Subscribe", 7.48], ["to", 7.8], ["PocketIQ", 7.98], ["for", 8.6], ["more", 8.78], ["smart", 8.98], ["money", 9.3], ["truths!", 9.62]]}, "script": 1, "v": true}